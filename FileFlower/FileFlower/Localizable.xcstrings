    "guide.topic.queue.conflicts.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entscheidest: überschreiben, eine Versionsnummer anhängen oder überspringen. Es wird nie etwas ohne Nachfrage ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose: overwrite, add a version number, or skip. Nothing is ever replaced without asking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eliges: sobrescribir, añadir un número de versión u omitir. Nunca se reemplaza nada sin preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est vous qui choisissez : écraser, ajouter un numéro de version ou ignorer. Rien n’est jamais remplacé sans demander."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kiest: overschrijven, een versienummer erachter, of overslaan. Er wordt nooit iets vervangen zonder te vragen."
          }
        }
      }
    },
