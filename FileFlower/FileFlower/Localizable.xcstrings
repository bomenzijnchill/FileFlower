    "folder_structure.param.help_break_desc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, erzeugen Schrägstriche im Wert verschachtelte Ordner (z. B. „Kunde/2026“ → Kunde/2026/…)."
