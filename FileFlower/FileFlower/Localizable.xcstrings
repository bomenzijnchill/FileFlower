    "guide.topic.queue.type-override.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik, SFX, VO, Footage, Motion Graphic, Graphic oder Stock Footage. Jede Korrektur füttert die Klassifizierung, sodass es beim nächsten Mal besser läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music, SFX, VO, footage, motion graphic, graphic or stock footage. Every correction feeds the classifier, so the next one is better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música, SFX, VO, footage, motion graphic, graphic o stock footage. Cada corrección alimenta la clasificación, así que la próxima vez sale mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musique, SFX, VO, rushes, motion graphic, graphic ou stock footage. Chaque correction alimente la classification, donc la fois suivante est meilleure."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek, SFX, VO, footage, motion graphic, graphic of stock footage. Elke correctie voedt de classificatie, dus de volgende keer gaat het beter."
          }
        }
      }
    },
