    "guide.topic.path.evidence-layers.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo Dateien dieses Typs bereits liegen, wiegt am schwersten, dann eine Analyse deines Ordnerbaums und zuletzt Stichwörter im Ordnernamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where files of this type already live counts heaviest, then an analysis of your folder tree, and finally keywords in the folder name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde están ya los archivos de este tipo es lo que más pesa, luego un análisis de tu árbol de carpetas y, por último, las palabras clave del nombre de la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’endroit où se trouvent déjà les fichiers de ce type pèse le plus lourd, puis une analyse de votre arborescence, et enfin les mots-clés du nom de dossier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar bestanden van dit type al staan weegt het zwaarst, dan een analyse van je mappenboom, en als laatste trefwoorden in de mapnaam."
          }
        }
      }
    },
    "guide.topic.path.blocked-folders.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
