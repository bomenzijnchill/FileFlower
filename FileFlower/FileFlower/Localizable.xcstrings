    "filesafe.help.bins" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Unterordner (Bins) um Dateien zu organisieren. Wählen Sie mehrere Dateien aus und weisen Sie sie einem Bin zu."
          }
        },
        "en" : {
          "stringUnit" : {
