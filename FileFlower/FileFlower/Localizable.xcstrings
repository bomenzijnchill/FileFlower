    "guide.topic.queue.history.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was heute verarbeitet wurde, bleibt sichtbar, und mit „Verschieben“ bringst du eine Datei nachträglich in ein anderes Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything processed today stays visible, and a 'move' button relocates a file to another project if you picked wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo procesado hoy sigue visible, y con «mover» llevas un archivo a otro proyecto si te equivocaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui a été traité aujourd’hui reste visible, et le bouton « déplacer » envoie un fichier vers un autre projet si vous vous êtes trompé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat vandaag verwerkt is blijft zichtbaar, en met 'verplaatsen' zet je een bestand alsnog naar een ander project."
          }
        }
      }
    },
