          }
        }
      }
    },
    "guide.topic.scope.local-only.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nie eine Datei hochgeladen. Nur die Analyse der Ordnerstruktur und das Feedback-Formular verlassen deinen Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No file is ever uploaded. Only the folder-structure analysis and the feedback form leave your machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se sube ningún archivo. Solo el análisis de la estructura de carpetas y el formulario de comentarios salen de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fichier n’est jamais envoyé. Seules l’analyse de la structure des dossiers et le formulaire de retour quittent votre Mac."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt nooit een bestand geüpload. Alleen de mappenanalyse en het feedbackformulier verlaten je Mac."
          }
        }
      }
    },
    "guide.topic.scope.nle-optional.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
