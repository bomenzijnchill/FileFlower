    "guide.topic.queue.quicklook.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Datei in der Warteschlange und drücke die Leertaste für eine QuickLook-Vorschau, genau wie im Finder."
          }
        },
        "en" : {
          "stringUnit" : {
