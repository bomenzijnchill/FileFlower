    "guide.path-resolution.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie er lernt, deine Ordnernamen zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How it learns to read your folder names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo aprende a leer tus nombres de carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment il apprend à lire vos noms de dossiers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe hij jóuw mapnamen leert lezen."
          }
        }
      }
    },
    "guide.path-resolution.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder benennt seine Ordner anders. Deshalb schaut FileFlower zuerst auf deine bestehende Struktur und erst danach auf den Dateinamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone names their folders differently. That is why FileFlower looks at your existing structure first, and at the file name only after that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno nombra sus carpetas de forma distinta. Por eso FileFlower mira primero tu estructura existente y solo después el nombre del archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun nomme ses dossiers différemment. C’est pourquoi FileFlower regarde d’abord votre structure existante, et seulement ensuite le nom du fichier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen noemt zijn mappen anders. Daarom kijkt FileFlower eerst naar je bestaande structuur, en pas daarna naar de bestandsnaam."
          }
        }
      }
    },
    "guide.path-resolution.why" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateinamen lügen – ein Voice-over heißt REC_0231.wav. Ordnernamen lügen nicht. Was schon in 03_Audio/03_VO liegt, sagt mehr als jedes Stichwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File names lie — a voice-over is called REC_0231.wav. Folder names do not. What already sits in 03_Audio/03_VO says more than any keyword could."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de archivo mienten: una locución se llama REC_0231.wav. Los nombres de carpeta no. Lo que ya hay en 03_Audio/03_VO dice más que cualquier palabra clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms de fichiers mentent — une voix off s’appelle REC_0231.wav. Les noms de dossiers, non. Ce qui se trouve déjà dans 03_Audio/03_VO en dit plus que n’importe quel mot-clé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestandsnamen liegen — een voice-over heet REC_0231.wav. Mapnamen liegen niet. Wat er al in 03_Audio/03_VO staat, zegt meer dan welk trefwoord ook."
          }
        }
      }
    },
