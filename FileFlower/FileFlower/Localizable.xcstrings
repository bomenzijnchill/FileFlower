    "guide.welcome.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lädst den ganzen Tag herunter. Danach schiebst du."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You download all day. Then you drag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargas todo el día. Después arrastras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous téléchargez toute la journée. Ensuite, vous glissez."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je downloadt de hele dag. Daarna sleep je."
          }
        }
      }
    },
    "guide.welcome.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower behält deinen Downloads-Ordner im Auge, erkennt, was ankommt, und legt es im richtigen Ordner des Projekts ab, in dem du gerade arbeitest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower watches your Downloads folder, recognises what arrives, and files it in the right folder of the project you are working in right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower vigila tu carpeta de Descargas, reconoce lo que llega y lo archiva en la carpeta correcta del proyecto en el que estás trabajando ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower surveille votre dossier Téléchargements, reconnaît ce qui arrive et le classe dans le bon dossier du projet sur lequel vous travaillez en ce moment."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower kijkt mee met je Downloads-map, herkent wat er binnenkomt, en zet het in de juiste map van het project waar je op dat moment in werkt."
          }
        }
      }
    },
    "guide.welcome.why" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schnitttag bringt Dutzende lose Downloads mit sich. Jeden einzelnen von Hand zu verschieben kostet Minuten – und geht schief, sobald du es eilig hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An editing day produces dozens of loose downloads. Dragging each one by hand costs minutes, and goes wrong the moment you are in a hurry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día de montaje genera decenas de descargas sueltas. Arrastrar cada una a mano cuesta minutos y sale mal en cuanto tienes prisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une journée de montage produit des dizaines de téléchargements épars. Glisser chacun à la main coûte des minutes, et tourne mal dès que vous êtes pressé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een montagedag levert tientallen losse downloads op. Elk daarvan handmatig verslepen kost minuten, en gaat mis zodra je haast hebt."
          }
        }
      }
    },
    "guide.welcome.demo_caption" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blütenblätter – die Landeanimation"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petals — the landing animation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pétalos — la animación de aterrizaje"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pétales — l’animation d’atterrissage"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloemblaadjes — de landingsanimatie"
          }
        }
      }
    },
    "guide.demo.petals.caption" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei, die landet, bekommt ihren Moment."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every file that lands gets a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada archivo que aterriza tiene su momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier qui atterrit a droit à son moment."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk bestand dat landt, waait even op."
          }
        }
      }
