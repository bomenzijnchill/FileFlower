    "settings.card.privacy.desc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower sendet niemals Dateinamen oder Pfade — nur ob eine Funktion benutzt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower never sends filenames or paths — only whether a feature was used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower nunca envía nombres de archivos ni rutas — solo si se usó una función."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower n'envoie jamais de noms de fichiers ou chemins — seulement l'utilisation des fonctions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower stuurt nooit bestandsnamen of paden terug — enkel of een feature gebruikt is."
          }
        }
      }
    },
