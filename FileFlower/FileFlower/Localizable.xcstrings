    "guide.topic.path.learned-rules.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählst du selbst einen anderen Ordner, wird daraus eine Regel, die Vorrang vor allem hat, was FileFlower selbst hergeleitet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a different folder and that becomes a rule which outranks everything FileFlower worked out by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliges otra carpeta, eso se convierte en una regla que tiene prioridad sobre todo lo que FileFlower dedujo por su cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous choisissez un autre dossier, cela devient une règle qui prime sur tout ce que FileFlower a déduit tout seul."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies je zelf een andere map, dan wordt dat een regel die voorrang krijgt op alles wat FileFlower zelf afleidde."
          }
        }
      }
    },
    "guide.topic.path.unknown-root.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fragt lieber, statt zu raten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It asks rather than guesses"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefiere preguntar antes que adivinar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il préfère demander plutôt que deviner"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij vraagt liever dan dat hij gokt"
          }
        }
      }
    },
    "guide.topic.path.unknown-root.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegt ein Projekt außerhalb deiner eingestellten Projektordner, hält FileFlower an und fragt nach, statt einfach irgendetwas zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a project sits outside your configured project folders, FileFlower stops and asks instead of picking something at random."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un proyecto está fuera de tus carpetas de proyectos configuradas, FileFlower se detiene y pregunta en vez de elegir algo al azar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un projet se trouve en dehors de vos dossiers de projets configurés, FileFlower s’arrête et pose la question au lieu de choisir au hasard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligt een project buiten je ingestelde projectmappen, dan stopt FileFlower en vraagt het, in plaats van zomaar iets te kiezen."
          }
        }
      }
    },
