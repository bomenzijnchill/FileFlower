    "guide.topic.scope.new-downloads-only.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er rührt nur neue Downloads an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only touches new downloads"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo toca las descargas nuevas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne touche qu’aux nouveaux téléchargements"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij raakt alleen nieuwe downloads aan"
          }
        }
      }
    },
    "guide.topic.scope.new-downloads-only.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower ordnet niemals Dateien um, die du bereits hast. Deine bestehenden Projekte bleiben genau so, wie du sie verlassen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower never reorganises files you already have. Your existing projects stay exactly as you left them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower nunca reorganiza los archivos que ya tienes. Tus proyectos existentes quedan exactamente como los dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower ne réorganise jamais les fichiers que vous avez déjà. Vos projets existants restent exactement comme vous les avez laissés."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower herordent nooit bestanden die je al hebt. Je bestaande projecten blijven precies zoals je ze achterliet."
          }
        }
      }
    },
    "guide.topic.scope.local-only.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles passiert auf deinem Mac"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything happens on your Mac"
          }
        },
        "es" : {
