          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileFlower se ejecuta en tu barra de menú y monitorea las descargas en segundo plano. ¿Quieres que se inicie automáticamente?"
          }
        },
        "fr" : {
          "stringUnit" : {
