        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, las barras en el valor crean carpetas anidadas (p. ej., \"Cliente/2026\" → Cliente/2026/…)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
