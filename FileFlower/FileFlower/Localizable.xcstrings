    "guide.download-sync.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Download in den richtigen Ordner, in vier Schritten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From download to the right folder, in four steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la descarga a la carpeta correcta, en cuatro pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du téléchargement au bon dossier, en quatre étapes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van download naar de juiste map, in vier stappen."
          }
        }
      }
    },
    "guide.download-sync.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Datei erscheint in der Warteschlange, wird klassifiziert, bekommt einen vorgeschlagenen Pfad und wandert mit einem Klick dorthin – inklusive Import in dein Schnittprogramm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new file appears in the queue, gets classified, is given a proposed path, and moves there with a single click — including the import into your editing program."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo nuevo aparece en la cola, se clasifica, recibe una ruta propuesta y se mueve allí con un solo clic, incluida la importación en tu programa de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau fichier apparaît dans la file d’attente, est classé, reçoit un chemin proposé et s’y déplace en un seul clic — import dans votre logiciel de montage compris."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuw bestand verschijnt in de wachtrij, wordt geclassificeerd, krijgt een voorgesteld pad, en gaat er met één klik heen — inclusief de import in je montageprogramma."
          }
        }
      }
    },
    "guide.download-sync.why" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vorgeschlagene Pfad steht schon da, bevor du klickst. Stimmt er, ist die Verarbeitung ein Klick. Stimmt er nicht, änderst du den Typ oder den Ordner – und das merkt sich FileFlower."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The proposed path is already there before you click. If it is right, processing is one click. If it is not, you change the type or the folder — and FileFlower remembers that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta propuesta ya está ahí antes de que hagas clic. Si es correcta, procesar es un clic. Si no, cambias el tipo o la carpeta, y FileFlower lo recuerda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chemin proposé est là avant même que vous cliquiez. S’il est correct, le traitement se fait en un clic. Sinon, vous changez le type ou le dossier — et FileFlower s’en souvient."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het voorgestelde pad staat er al vóórdat je klikt. Klopt het, dan is verwerken één klik. Klopt het niet, dan verander je het type of de map — en dat onthoudt FileFlower."
          }
        }
      }
    },
    "guide.download-sync.demo_caption" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ganze Kreislauf – vom Download bis zum Ordner"
          }
        },
        "en" : {
