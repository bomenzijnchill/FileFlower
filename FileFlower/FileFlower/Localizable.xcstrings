    "guide.topic.path.blocked-folders.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es landet nie etwas in „Adobe Premiere Pro Audio Previews“ oder „Premiere Auto-Save“, egal wie gut der Name zu passen scheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing ever ends up in 'Adobe Premiere Pro Audio Previews' or 'Premiere Auto-Save', no matter how well the name seems to match."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca acaba nada en «Adobe Premiere Pro Audio Previews» ni en «Premiere Auto-Save», por bien que parezca encajar el nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’atterrit jamais dans « Adobe Premiere Pro Audio Previews » ou « Premiere Auto-Save », même si le nom semble parfaitement correspondre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er belandt nooit iets in 'Adobe Premiere Pro Audio Previews' of 'Premiere Auto-Save', hoe goed de naam ook lijkt te passen."
          }
        }
      }
    },
    "guide.topic.path.learned-rules.title" : {
