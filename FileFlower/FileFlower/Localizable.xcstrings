    "guide.topic.scope.nle-optional.lead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit Premiere Pro, mit DaVinci Resolve, mit beiden oder mit keinem von beiden – dann sortiert er einfach deine Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works with Premiere Pro, with DaVinci Resolve, with both, or with neither — then it just sorts your files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con Premiere Pro, con DaVinci Resolve, con ambos o con ninguno: en ese caso, simplemente ordena tus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec Premiere Pro, avec DaVinci Resolve, avec les deux ou avec aucun — dans ce cas, il se contente de trier vos fichiers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt met Premiere Pro, met DaVinci Resolve, met allebei, of met geen van beide — dan sorteert hij alleen je bestanden."
          }
        }
      }
    },
